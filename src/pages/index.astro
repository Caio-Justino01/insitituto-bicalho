---
import Layout from '../layouts/Layout.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import BookingLink from '../components/BookingLink.astro';
import Precision from '../components/Precision.astro';
import Faq from '../components/Faq.astro';
import Units from '../components/Units.astro';
import { areas, team, homeQuestions } from '../data/content';
const photos = ['hero', 'smile', 'aligners', 'precision'] as const;
---
<Layout title="Instituto Bicalho | Clínica Odontológica de Precisão" appendBrand={false} description="Clínica odontológica em João Monlevade e Belo Horizonte. Equipe multidisciplinar de dentistas, planejamento individualizado e tecnologia digital do diagnóstico ao tratamento.">
  <section class="hero" aria-labelledby="hero-heading">
    <div class="container hero-layout">
      <div class="hero-copy">
        <span class="hero-eyebrow"><span class="status-dot" aria-hidden="true"></span>Odontologia de Precisão</span>
        <h1 id="hero-heading">Clínica odontológica <br/><span>em João Monlevade e Belo Horizonte.</span></h1>
        <p>Planejamento individualizado, equipe multidisciplinar de dentistas e tecnologia digital do diagnóstico ao resultado.</p>
        <div class="hero-actions"><BookingLink position="hero" id="primary-booking"/><a class="text-link" href="#instituto">Conheça o Instituto<Icon name="arrow" size={18}/></a></div>
        <span class="hero-location"><Icon name="pin" size={18}/>João Monlevade e Belo Horizonte</span>
      </div>
      <div class="hero-visual">
        <Photo name="hero" class="hero-photo" eager sizes="(min-width: 1000px) 48vw, 100vw"/>
        <div class="photo-tags" aria-hidden="true"><span>Escuta</span><span>Cuidado</span><span>Tecnologia</span></div>
        <div class="hero-glass glass"><span class="circle-icon"><Icon name="tooth" size={25}/></span><div><strong>Você no centro do cuidado.</strong><p>Da primeira conversa a cada novo sorriso.</p></div></div>
      </div>
    </div>
    <div class="container hero-footnote"><span>Saúde, função e estética. Juntas.</span><a href="#instituto">Explore o Instituto<Icon name="arrow" size={18}/></a></div>
  </section>
  <section class="section institution" id="instituto" aria-labelledby="institution-heading">
    <div class="container">
      <div class="institution-layout">
        <div class="institution-copy"><span class="eyebrow">Instituto Bicalho Odontologia de Precisão</span><h2 id="institution-heading">Uma equipe, <br/><span>várias especialidades.</span></h2><p class="lead-copy">Avaliação individualizada antes de qualquer tratamento.</p><p>A equipe reúne implantodontia, ortodontia, odontopediatria, prótese dentária, endodontia, periodontia e harmonização orofacial, com planejamento conjunto quando o caso exige mais de uma especialidade.</p><p>O acompanhamento começa pela queixa e pelo histórico do paciente, segue para o exame clínico e, quando indicado, para o planejamento digital antes de qualquer procedimento.</p></div>
        <div class="partner-photos"><Photo name="partnerOne" sizes="(min-width: 1000px) 23vw, 46vw"/><Photo name="partnerTwo" sizes="(min-width: 1000px) 23vw, 46vw"/><div class="portrait-note glass"><span class="status-dot" aria-hidden="true"></span><span>Dr. Bruno Bicalho e Dra. Roberta Souza Carneiro, sócios do Instituto Bicalho.</span></div></div>
      </div>
      <div id="equipe">
        <details class="team-panel" id="equipe-completa"><summary><span>Conheça nossa equipe<small>Profissionais e áreas de atuação</small></span><span class="round-arrow"><Icon name="plus" size={22}/></span></summary><div class="team-panel-content"><div class="team-grid">{team.map(person => <article class="team-person"><h3>{person.name}</h3>{person.role && <span class="team-role">{person.role}</span>}<p><span class="team-kind">{person.kind}</span>{person.work}</p></article>)}</div></div></details>
      </div>
    </div>
  </section>
  <section class="section areas" aria-labelledby="areas-heading"><div class="container">
    <div class="section-intro"><div><span class="eyebrow">Nossas áreas de cuidado</span><h2 id="areas-heading">Quatro áreas, <br/><span>um só planejamento.</span></h2></div><p>Tratamentos, estética, ortodontia e cirurgia, e odontologia de precisão, detalhados a seguir.</p></div>
    <div class="area-grid">{areas.map((area, i) => <a class={`area-card area-card-${i+1}`} href={`/${area.slug}/`}><Photo name={photos[i]} class="area-photo" sizes="(min-width: 1000px) 50vw, 100vw"/><span class="area-number" aria-hidden="true">0{i+1}</span><div class="area-card-copy glass"><div class="area-card-title"><h3>{area.title}</h3><span class="round-arrow"><Icon name="arrow" size={21}/></span></div><p>{area.homeSummary ?? area.short}</p><span class="area-link">Explorar cuidados</span></div></a>)}</div>
  </div></section>
  <Precision/>
  <Faq questions={homeQuestions}/>
  <Units heading={['Duas unidades,', 'um só padrão de cuidado.']}/>
</Layout>
