---
import Layout from '../layouts/Layout.astro';
import { nav } from '../data/content';
---
<Layout title="Página não encontrada" description="Encontre o cuidado que procura no Instituto Bicalho." noindex><section class="section error-page container"><span class="error-number">404</span><h1>Vamos encontrar<br/>um novo caminho.</h1><p>Esta página não está disponível. Você pode voltar ao início ou conhecer nossas áreas de cuidado.</p><a class="button" href="/">Voltar ao início</a><nav aria-label="Páginas disponíveis">{nav.slice(1).map(item => <a class="text-link" href={item.href}>{item.label}</a>)}</nav></section></Layout>
