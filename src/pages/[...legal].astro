---
import Text from '../components/TypographyText.astro';
import Layout from '../layouts/Layout.astro';
import { legalPages } from '../data/legal';
export function getStaticPaths() { return legalPages.map(page => ({ params: { legal: page.slug }, props: { page } })); }
const { page } = Astro.props;
---
<Layout title={page.title} description={page.intro}><article class="container section legal"><nav class="breadcrumb" aria-label="Caminho da página"><a href="/">Início</a><span>/</span><span><Text text={page.title}/></span></nav><h1><Text keepEnd={false} text={page.title}/></h1><p class="legal-date"><Text text="Versão de 14 de outubro de 2026"/></p><p><Text text={page.intro}/></p>{page.sections.map(([heading, text]) => <section><h2><Text keepEnd={false} text={heading}/></h2><p><Text text={text}/></p></section>)}<p><a href="/#unidades">Fale com a equipe do Instituto Bicalho</a></p>{page.slug.includes('cookies') && <button class="button" data-cookie-settings>Revisar preferências de cookies</button>}</article></Layout>
