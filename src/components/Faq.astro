---
import Icon from './Icon.astro';
interface Props { questions: [string, string][]; eyebrow?: string; heading?: string; intro?: string }
const { questions, eyebrow = 'Vamos conversar?', heading, intro = 'Algumas respostas para você dar o primeiro passo com tranquilidade.' } = Astro.props;
---
<section class="section faq" aria-labelledby="faq-heading">
  <div class="container faq-layout">
    <div class="section-heading" data-reveal><span class="eyebrow">{eyebrow}</span>{heading ? <h2 id="faq-heading">{heading}</h2> : <h2 id="faq-heading">Informação também é cuidado.</h2>}<p>{intro}</p></div>
    <div class="faq-list">{questions.map(([question, answer]) => <details><summary>{question}<Icon name="plus" size={20}/></summary><div class="faq-answer"><p>{answer}</p></div></details>)}</div>
  </div>
</section>
